# Copiar a .env y ajustar los valores. Nunca subir .env al repositorio.

# Base de datos. Con `docker compose up -d db` queda expuesta en el puerto 5433 del host.
# (Dentro de Docker, compose.yml sobreescribe esta URL para apuntar al servicio `db`.)
DATABASE_URL=postgresql://asistencia:asistencia@localhost:5433/asistencia

# NextAuth: URL publica del sistema y secreto para firmar los JWT.
# Generar un secreto: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia-este-secreto

# Clave compartida del kiosco. Ambas variables deben tener EL MISMO valor.
# NEXT_PUBLIC_API_KIOSCO_KEY se incrusta en el bundle del navegador al compilar (es publica).
# En Docker, compose.yml la toma de API_KIOSCO_KEY como build arg.
API_KIOSCO_KEY=kiosco-local-key
NEXT_PUBLIC_API_KIOSCO_KEY=kiosco-local-key

# Zona horaria del proceso (la logica de negocio usa hora de Venezuela).
TZ=America/Caracas

# Opcionales
# CIERRE_AUTOMATICO=false       # desactiva el cierre diario automatico (cada 15 min)
# GUARDAR_FOTO_FICHAJE=false
